{
  "apiVersion": "erpbridge.io/v1",
  "kind": "MCPTool",
  "metadata": {
    "name": "list_purchase_orders",
    "version": "1.0.0",
    "module": "erp"
  },
  "spec": {
    "description": {
      "short": "List all purchase orders and their current status (e.g., To Receive and Bill).",
      "whenToUse": null,
      "whenNotToUse": null,
      "examples": null
    },
    "inputSchema": {
      "type": "object",
      "properties": {}
    },
    "outputSchema": {
      "properties": {
        "data": {
          "items": {
            "$ref": "#/components/schemas/PurchaseOrder"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "execution": {
      "type": "http",
      "method": "GET",
      "endpoint": "http://localhost:8081/api/resource/Purchase Order",
      "responsePath": "data"
    },
    "security": {
      "authType": "api-key",
      "credentialRef": "ERP_PRIMARY_KEY"
    }
  }
}