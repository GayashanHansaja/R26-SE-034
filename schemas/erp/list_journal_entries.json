{
  "apiVersion": "erpbridge.io/v1",
  "kind": "MCPTool",
  "metadata": {
    "name": "list_journal_entries",
    "version": "1.0.0",
    "module": "erp"
  },
  "spec": {
    "description": {
      "short": "Retrieve all journal entries for accounting audits and ledger verification.",
      "whenToUse": null,
      "whenNotToUse": null,
      "examples": null
    },
    "inputSchema": {
      "type": "object",
      "properties": {}
    },
    "outputSchema": {
      "properties": {
        "data": {
          "items": {
            "$ref": "#/components/schemas/JournalEntry"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "execution": {
      "type": "http",
      "method": "GET",
      "endpoint": "http://localhost:8081/api/resource/Journal Entry",
      "responsePath": "data"
    },
    "security": {
      "authType": "api-key",
      "credentialRef": "ERP_PRIMARY_KEY"
    }
  }
}