{
  "name": "erp.GET-resource-Item-{name}",
  "description": "Retrieve detailed technical and commercial information for a specific item by its item code or name.",
  "module": "erp",
  "cache": {
    "enabled": true,
    "ttlSeconds": 3600,
    "semanticThreshold": 0.85,
    "isReadOnly": true
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      }
    },
    "required": [
      "name"
    ]
  },
  "outputSchema": {
    "properties": {
      "data": {
        "$ref": "#/components/schemas/Item"
      }
    },
    "type": "object"
  },
  "endpoint": {
    "method": "GET",
    "path": "http://localhost:8081/api/resource/Item/{name}",
    "auth": {
      "type": "api-key",
      "header": "Authorization",
      "keyRef": "token adm_key_001:adm_sec_stu901",
      "username": "",
      "token": ""
    }
  }
}
